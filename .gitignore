# Local-only agent/session context (never publish: lab notes, personal plans).
# AGENTS.md is the current filename; CLAUDE.md kept for the pre-rename history.
AGENTS.md
CLAUDE.md
# Paper-drafting file: local working document, same as CLAUDE.md.
RESEARCH.md
claude_continuation_guide.txt
vishwas.txt

# Python
__pycache__/
*.pyc
*.egg-info/
.python-version

# macOS
.DS_Store

# Heavy experiment outputs (tables/ and plots/ stay tracked)
results/checkpoints/
results/logs/
# rollout GIFs (large binaries); the filmstrip PNGs in results/plots/ are tracked.
# NOTE: git only treats '#' as a comment at the START of a line -- a trailing
# comment here would make the pattern literal and silently ignore nothing.
results/videos/

# Cluster (Hyak/slurm) outputs (requirements.lock.hyak.txt stays tracked:
# it is the Linux/CUDA half of the reproducibility appendix)
slurm-*.out
results_seed*/
results_smoke*/

# Generated house pairs. The cluster is the source of truth while the severity
# ladder is still being verified: a stale local copy pulled over a freshly
# generated one silently swaps the benchmark out from under every result.
# Once the C1-C3 gate passes 15/15, commit the verified set deliberately with
# `git add -f data/pairs`.
# (Comments must be on their own line -- git does NOT strip trailing comments,
# it treats them as part of the pattern.)
data/pairs/

# Per-cell plots the grid emits automatically: one PNG per run, ~5 MB across the
# grid, regenerable from the CSVs beside them, and superseded by the aggregate
# figure in scripts/plot_ladder.py. The tables themselves ARE tracked -- they are
# the result.
results/grid/**/*.png
