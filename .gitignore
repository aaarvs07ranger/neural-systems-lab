# Local-only agent/session context (never publish: lab notes, personal plans).
# AGENTS.md is the current filename; CLAUDE.md kept for the pre-rename history.
AGENTS.md
CLAUDE.md
claude_continuation_guide.txt
vishwas.txt

# Python
__pycache__/
*.pyc
*.egg-info/
.python-version

# macOS
.DS_Store

# Heavy experiment outputs (tables/ and plots/ stay tracked)
results/checkpoints/
results/logs/
# rollout GIFs (large binaries); the filmstrip PNGs in results/plots/ are tracked.
# NOTE: git only treats '#' as a comment at the START of a line -- a trailing
# comment here would make the pattern literal and silently ignore nothing.
results/videos/

# Cluster (Hyak/slurm) outputs (requirements.lock.hyak.txt stays tracked:
# it is the Linux/CUDA half of the reproducibility appendix)
slurm-*.out
results_seed*/
results_smoke*/
